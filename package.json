{
  "name": "marketplace-multifilter",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
